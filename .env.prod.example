# .env.prod.example — copy to .env.prod on the Pi and fill in real values.
# NEVER commit .env.prod.
#
# Read by every service in docker-compose.prod.yml, so it holds both the
# PICKONE_* settings (the configuration register) and the POSTGRES_* variables
# the postgres image expects.

# ── App ───────────────────────────────────────────────────────────────────────
# The API refuses to start in production if any of the following is wrong:
# a development secret, a secret under 32 chars, a localhost database URL, or a
# non-https base URL. That check runs at boot, not on first request.
PICKONE_ENV=production
PICKONE_LOG_LEVEL=INFO

# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
PICKONE_SECRET_KEY=CHANGEME

# Public origin. Used for canonical URLs, Open Graph and the sitemap.
PICKONE_BASE_URL=https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# Host is the compose service name, not localhost — the API talks to it over
# pickone_net, and a localhost URL here is rejected at boot.
PICKONE_DATABASE_URL=postgresql+asyncpg://pickone:CHANGEME@db:5432/pickone
POSTGRES_USER=pickone
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=pickone

# Pi-sized pools. The battle completion transaction holds row locks
# ([SPEC §9.4]), so a bigger pool converts contention into lock waits rather
# than throughput. Raise only with a measured reason.
PICKONE_DB_POOL_SIZE=4
PICKONE_DB_POOL_MAX_OVERFLOW=2

# ── Frontend ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* values are inlined by Next at BUILD time, not read here at
# runtime. They are set as build args by `make push`; these entries exist so the
# file documents the full surface. Changing them here changes nothing until the
# image is rebuilt.
NEXT_PUBLIC_ENV=production
NEXT_PUBLIC_BASE_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com
